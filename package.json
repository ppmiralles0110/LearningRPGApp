{
  "name": "levelup-architect",
  "version": "0.1.0",
  "private": true,
  "description": "An adaptive RPG-style learning platform for Cloud Solution Architects.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
