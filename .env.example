# Required in production. Generate at least 32 random bytes.
AUTH_SECRET=replace-with-a-long-random-secret

# Local SQLite file. Use an absolute path in hosted environments with mounted storage.
DATABASE_PATH=./data/levelup-architect.db

# Private local certificate evidence. Back up this folder with the SQLite database.
CERTIFICATE_UPLOAD_DIR=./data/certificates

# local works without a paid service. openai-compatible requires all values below.
MENTOR_PROVIDER=local
MENTOR_API_URL=
MENTOR_API_KEY=
MENTOR_MODEL=

# Optional deployment metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use false only for local HTTP. Hosted deployments must use HTTPS and true.
SESSION_COOKIE_SECURE=false
